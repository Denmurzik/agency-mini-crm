{
  "name": "crm-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Userbot-воркер мини-CRM: входящие личные сообщения Telegram становятся лидами",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "postgres": "^3.4.9",
    "telegram": "^2.26.22",
    "typescript": "^7.0.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "tsx": "^4.23.15",
    "vitest": "^5.0.3"
  }
}
