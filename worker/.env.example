# Postgres (та же база Neon, что и у CRM; воркер трогает только tg_accounts)
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# Данные приложения Telegram: https://my.telegram.org -> API development tools
TG_API_ID=
TG_API_HASH=

# Ключ шифрования сессии: 64 hex-символа (32 байта). Сгенерировать: openssl rand -hex 32
SESSION_ENC_KEY=

# Куда отправлять лиды (CRM) и общий секрет с CRM (INGEST_SECRET в Vercel)
INGEST_URL=https://your-crm.vercel.app/api/ingest
INGEST_SECRET=

# Секрет HTTP API воркера (WORKER_SECRET в Vercel)
WORKER_SECRET=

# Порт HTTP API (Railway подставляет PORT сам)
PORT=8787
