# ── CRM (Vercel) ──────────────────────────────────────────────
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require
# Прямое (не pooler) подключение — для миграций drizzle-kit, необязательно
DATABASE_URL_DIRECT=
TELEGRAM_BOT_TOKEN=123456:ABC...
TELEGRAM_BOT_USERNAME=my_agency_bot
# Любая случайная строка: Telegram присылает её в заголовке X-Telegram-Bot-Api-Secret-Token
TELEGRAM_WEBHOOK_SECRET=
# Пароль входа в CRM
CRM_PASSWORD=
# Секрет подписи cookie сессии и токенов подписки (openssl rand -hex 32)
AUTH_SECRET=
# Общий секрет воркер → CRM (/api/ingest)
INGEST_SECRET=
# Адрес и секрет HTTP API воркера (CRM → воркер)
WORKER_URL=http://localhost:8787
WORKER_SECRET=
# Публичный адрес CRM (ссылки в уведомлениях, webhook)
APP_URL=http://localhost:3000
# "1" — запретить подключать/отключать Telegram-аккаунт из UI (демо для проверяющих)
CHANNELS_LOCKED=

# ── Воркер (Railway), worker/.env ─────────────────────────────
# DATABASE_URL=...            та же база
# TG_API_ID= TG_API_HASH=     с my.telegram.org
# SESSION_ENC_KEY=            32 байта hex (openssl rand -hex 32)
# INGEST_URL=https://<app>/api/ingest
# INGEST_SECRET=  WORKER_SECRET=  PORT=8787
